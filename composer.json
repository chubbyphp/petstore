{
    "name": "chubbyphp/petstore",
    "description": "A simple skeleton to build api's based on the chubbyphp-framework.",
    "keywords": [
        "chubbyphp",
        "framework",
        "skeleton"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Dominik Zogg",
            "email": "dominik.zogg@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "chubbyphp/chubbyphp-clean-directories": "^1.5",
        "chubbyphp/chubbyphp-cors": "^1.7",
        "chubbyphp/chubbyphp-decode-encode": "^1.3",
        "chubbyphp/chubbyphp-framework": "^5.3",
        "chubbyphp/chubbyphp-framework-router-fastroute": "^2.3",
        "chubbyphp/chubbyphp-http-exception": "^1.3",
        "chubbyphp/chubbyphp-laminas-config": "^1.5",
        "chubbyphp/chubbyphp-laminas-config-doctrine": "^3.1",
        "chubbyphp/chubbyphp-laminas-config-factory": "^1.5",
        "chubbyphp/chubbyphp-negotiation": "^2.3",
        "chubbyphp/chubbyphp-parsing": "^2.1",
        "doctrine/mongodb-odm": "^2.15.1",
        "monolog/monolog": "^3.9",
        "ramsey/uuid": "^4.9.1",
        "slim/psr7": "^1.8",
        "symfony/console": "^7.4.0"
    },
    "require-dev": {
        "chubbyphp/chubbyphp-dev-helper": "dev-master",
        "chubbyphp/chubbyphp-mock": "^2.1",
        "dg/bypass-finals": "^1.9",
        "infection/infection": "^0.31.9",
        "php-coveralls/php-coveralls": "^2.9",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "clean-directories": "bin/console clean-directories cache log",
        "database:schema:drop": "bin/console odm:schema:drop --db",
        "database:schema:update": "bin/console odm:schema:update",
        "database:schema:validate": "bin/console odm:schema:validate",
        "fix:cs": "mkdir -p build && vendor/bin/php-cs-fixer fix --cache-file=build/phpcs.cache",
        "setup:dev": [
            "@database:schema:drop --env=dev",
            "@database:schema:update --env=dev",
            "@clean-directories --env=dev"
        ],
        "setup:phpunit": [
            "@database:schema:drop --env=phpunit",
            "@database:schema:update --env=phpunit",
            "@clean-directories --env=phpunit"
        ],
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:infection",
            "@test:integration",
            "@test:static-analysis",
            "@test:cs"
        ],
        "test:cs": "mkdir -p build && vendor/bin/php-cs-fixer fix --dry-run --stop-on-violation --cache-file=build/phpcs.cache",
        "test:infection": "vendor/bin/infection --threads=$(nproc) --min-msi=99 --verbose --coverage=build/phpunit",
        "test:integration": "vendor/bin/phpunit --configuration phpunit.integration.xml --cache-directory=build/phpunit/integration.cache",
        "test:lint": "mkdir -p build && find src tests -name '*.php' -print0 | xargs -0 -n1 -P$(nproc) php -l | tee build/phplint.log",
        "test:static-analysis": "mkdir -p build && bash -c 'vendor/bin/phpstan analyse src --no-progress --level=8 --error-format=junit | tee build/phpstan.junit.xml; if [ ${PIPESTATUS[0]} -ne \"0\" ]; then exit 1; fi'",
        "test:unit": "vendor/bin/phpunit --coverage-text --coverage-clover=build/phpunit/clover.xml --coverage-html=build/phpunit/coverage-html --coverage-xml=build/phpunit/coverage-xml --log-junit=build/phpunit/junit.xml --cache-directory=build/phpunit/unit.cache"
    }
}
